{
  "$schema": "../contracts.schema.json",
  "master": "Screen/Editor",
  "level": "L4",
  "does": "Disegnare e modellare un glifo su griglia, cambiare look, collegare una cella all'audio, animare scene/layer, salvare.",
  "receives": {
    "project": { "id": "string", "name": "string", "grid": { "cols": "number", "rows": "number" }, "look": { "ink": "color", "paper": "color" } },
    "selection": { "kind": "cell | layer | scene | null", "x": "number?", "y": "number?" },
    "tool": { "active": "select | draw | erase | toggle", "brush": "number" },
    "scene": { "id": "string", "layers": "array", "grid": "object" },
    "audio": { "loaded": "boolean", "preset": "level | kick | bass | bpm", "enabled": "boolean" }
  },
  "allows": ["paint cell", "erase cell", "select cell", "change tool", "change look", "change grid", "load audio", "animate scene", "add layer", "set ghost", "add modulation", "export", "save", "open palette", "open context menu"],
  "variants": ["State=Full", "State=Empty", "State=Target", "State=Audio error", "State=Grid", "State=Animate", "State=Animate cell", "State=Animate noise"],
  "states": {
    "full": "griglia disegnata, toolbar expanded, Inspector rail Tool/BRUSH",
    "empty": "griglia vuota + hint in canvas, glyph Clear, inspector su Look",
    "target": "target picker a colonne, cella selezionata, dock audio",
    "audio error": "dock Expanded·Error, waveform destructive, messaggio",
    "grid": "inspector Grid, columns/rows/corners, rail Grid",
    "animate": "Scenes/Layers/Presets, ghost, Inspector Motion, TimelineDock",
    "cell": "cell mode sul canvas, barra Pick a cell, target Cell 3·5",
    "noise": "Noise → Effects, Scope All cells, Loop Proportional, preview 5×5",
    "loading": "solo audio (spinner nello slot file)",
    "partial": "cella senza audio → messaggio e CTA"
  },
  "tokens": ["background", "card", "popover", "border", "foreground", "muted-foreground", "selection", "selection-solid", "accent", "ring"],
  "geometry": {
    "screen": "1440×900",
    "rail": "$size/rail",
    "sidebar": "$size/sidebar",
    "inspector": "$size/inspector",
    "inspectorRail": 48,
    "inspectorBody": 232,
    "header": 44,
    "toolbar": "48×48 / 48×236",
    "glyph": "400×400 (5×5)",
    "row": "$row/28"
  },
  "composition": ["Organism/NavRailItem", "Molecule/SearchField", "Organism/TreeRow", "Organism/TreeRow-Child", "Molecule/Segmented", "Molecule/InspectorRow", "Molecule/Button", "Organism/Toolbar", "Organism/InspectorRail", "Organism/GlyphGrid", "Organism/TimelineDock", "Atom/Kbd"],
  "surfaceContexts": ["background"],
  "icons": ["layout-grid", "layers", "image", "settings", "undo-2", "redo-2", "chevron-down", "plus", "search", "pencil", "eraser", "mouse-pointer-2", "play", "download"],
  "a11y": {
    "contrast": "CONTRAST-MATRIX.md",
    "focus": "ring 2px, sempre visibile",
    "targets": "44 toolbar/rail, 32 controls, 24 clip/cell",
    "reducedMotion": "rispettato"
  },
  "specCard": "03 UI → Screens/Editor → Head",
  "codePath": "src/screens/editor.tsx (PHASE 7)"
}
